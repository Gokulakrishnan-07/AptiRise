# Application Configuration
APP_NAME=AptiRise
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL preferred, SQLite default fallback)
DATABASE_URL=sqlite:///./aptirise.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/aptirise

# Hugging Face API (Used for question classification, difficulty detection, explanations)
HF_TOKEN=your_hugging_face_token_here

# Google OAuth Credentials (Optional for local testing, required for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Initial Admin Credentials (Created automatically on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aptirise.internal
ADMIN_PASSWORD=change-this-before-running

# Game Configuration Defaults
DEFAULT_TIMER_SECONDS=45
BASE_CORRECT_XP=100
SPEED_BONUS_UNDER_50=50
SPEED_BONUS_UNDER_25=100
PERFECT_LEVEL_BONUS_XP=250
DAILY_CHALLENGE_BONUS_XP=500
MAX_UPLOAD_SIZE_MB=25
